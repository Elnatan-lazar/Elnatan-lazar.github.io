# WhatsApp Notification - choose one method

# Option A: Webhook (Zapier / Make.com)
WHATSAPP_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/YOUR_HOOK_ID

# Option B: Green-API (direct WhatsApp)
GREEN_API_INSTANCE_ID=your_instance_id
GREEN_API_TOKEN=your_token
GREEN_API_PHONE=972XXXXXXXXX   # recipient phone in international format, no +

# Option C: Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM=whatsapp:+14155238886
TWILIO_TO=whatsapp:+972XXXXXXXXX
